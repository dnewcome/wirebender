<mujoco model="wirebender">
  <!-- Generated by sim/make_mjcf.py. Bending head = real meshes; rest = rough primitives. -->
  <compiler angle="degree" meshdir="meshes" autolimits="true" inertiafromgeom="true"/>
  <option gravity="0 0 0" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="960" azimuth="120" elevation="-20"/>
    <quality shadowsize="2048"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4"/>
  </visual>
  <statistic center="0.00635 0.1925 0.0055" extent="0.25"/>

  <default>
    <joint damping="0.5"/>
    <position kp="8" forcerange="-80 80"/>
    <!-- collisions off: kinematic visualization -->
    <geom density="1000" contype="0" conaffinity="0"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.25 0.3 0.4" rgb2="0.05 0.06 0.1"
             width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.1"/>
    <mesh name="motor" file="motor.stl" scale="0.001 0.001 0.001"/>
    <mesh name="bender-head" file="bender-head.stl" scale="0.001 0.001 0.001"/>
    <mesh name="motor-flange" file="motor-flange.stl" scale="0.001 0.001 0.001"/>
    <mesh name="bracket" file="bracket.stl" scale="0.001 0.001 0.001"/>
    <mesh name="head" file="head.stl" scale="0.001 0.001 0.001"/>
    <mesh name="bend_gear" file="bend_gear.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0.2 0.1 0.5" dir="-0.3 -0.1 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0.1925 -0.044"
          material="grid" contype="1" conaffinity="1"/>

    <!-- ───────── static frame / decoration ───────── -->
    <body name="frame">
      <!-- printed base/bracket (base-bracket.scad) -->
      <geom type="mesh" mesh="bracket" pos="0.00635 0.035 -0.0445" quat="0.707107 0 0 0.707107" rgba="0.66 0.68 0.72 1"/>
      <!-- feeder body (1KGSSJ-B): flat on the base -->
      <geom type="box" pos="0.00635 0.185 -0.0295" size="0.0425 0.061 0.015" rgba="0.18 0.19 0.22 1"/>
      <!-- feeder motor dropping ~48mm through the base pocket -->
      <geom type="cylinder" fromto="0.00635 0.20525 -0.0445 0.00635 0.20525 -0.0925" size="0.0265" rgba="0.25 0.27 0.30 1"/>
      <!-- tension knob over the top -->
      <geom type="cylinder" fromto="0.00635 0.143 -0.0145 0.00635 0.143 -0.0005" size="0.011" rgba="0.08 0.08 0.08 1"/>
    </body>

    <!-- ───────── Axis 1: wire feed (slide along Y) ───────── -->
    <body name="wire" pos="0.00635 0 0.0055">
      <joint name="feed" type="slide" axis="0 1 0" range="-0.12 0.04"/>
      <geom type="capsule" fromto="0 -0.055 0  0 0.23 0"
            size="0.000815" rgba="0.80 0.80 0.85 1"/>
    </body>

    <!-- ───────── Axis 2: feed-tube rotation (bend direction) ───────── -->
    <body name="tube" pos="0 0 0">
      <joint name="tube_rot" type="hinge" axis="0 1 0" pos="0.00635 0 0.0055"
             range="-90 90"/>
      <!-- feed tube -->
      <geom type="cylinder" fromto="0.00635 -0.01 0.0055 0.00635 0.085 0.0055" size="0.004" rgba="0.62 0.64 0.68 1"/>
      <!-- drive pulley -->
      <geom type="cylinder" fromto="0.00635 0.043 0.0055 0.00635 0.051 0.0055" size="0.02" rgba="0.15 0.16 0.18 1"/>
      <!-- bending head housing (head.scad) -->
      <geom type="mesh" mesh="head" pos="0.00635 0 -0.0075" quat="0 0 0 1" rgba="0.20 0.55 0.85 1"/>

      <!-- ───────── Axis 3: bend head ───────── -->
      <body name="bend_flange" pos="0 0 0">
        <joint name="bend" type="hinge" axis="0 0 1" pos="0.00355 0 0.0055"
               range="0 150"/>
        <geom type="mesh" mesh="bend_gear" pos="0.00355 0 0.0015" quat="0 0 0 1" rgba="0.90 0.55 0.15 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="feed"     joint="feed"     ctrlrange="-0.12 0.04" kp="200"/>
    <position name="tube_rot" joint="tube_rot" ctrlrange="-90 90"/>
    <position name="bend"     joint="bend"     ctrlrange="0 150"/>
  </actuator>
</mujoco>
